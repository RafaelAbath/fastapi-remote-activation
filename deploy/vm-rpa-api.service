# Exemplo de unidade systemd para a VM Ubuntu.
# Copiar para /etc/systemd/system/ e: systemctl daemon-reload && systemctl enable --now vm-rpa-api
[Unit]
Description=API das VMs de RPA (SIAGS Flow)
After=network-online.target
Wants=network-online.target

[Service]
User=rpa
WorkingDirectory=/opt/vm-rpa-api
EnvironmentFile=/opt/vm-rpa-api/.env
ExecStart=/opt/vm-rpa-api/.venv/bin/uvicorn app.main:create_app --factory --host 0.0.0.0 --port 8000 --no-server-header
KillMode=mixed
TimeoutStopSec=30
Restart=on-failure

[Install]
WantedBy=multi-user.target
