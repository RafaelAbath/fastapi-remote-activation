# Token desta VM (o mesmo cadastrado no painel em RPAs › Máquinas).
VM_API_TOKEN=troque-este-token

# Allowlist de scripts: nome -> comando executado. Só estes nomes são aceitos em POST /api/v1/jobs.
VM_SCRIPTS='{"extracao": ["python3", "examples/fake_rpa.py", "extracao"], "designacao": ["python3", "examples/fake_rpa.py", "designacao"], "previa_envio": ["python3", "examples/fake_rpa.py", "previa_envio"]}'
# Na VM real, cada nome aponta para o script do designacao-automacao, ex.:
# "conferencia_aria": ["/opt/rpa/.venv/bin/python", "/opt/rpa/conferencia_aria.py"]   (Relatório Aria)

# Painel que recebe os resultados (::extracao / ::designacao / ::envio_aria). Sem ela, os itens ficam guardados sem envio.
# VM_PAINEL_URL=https://painel.exemplo.com.br

