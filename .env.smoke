# Token desta VM (o mesmo cadastrado no painel em RPAs › Máquinas).
VM_API_TOKEN=troque-este-token

# Allowlist de scripts: nome -> comando executado. Só estes nomes são aceitos em POST /api/v1/jobs.
VM_SCRIPTS={"extracao": ["python3", "examples/fake_rpa.py", "extracao"], "designacao": ["python3", "examples/fake_rpa.py", "designacao"]}

